# DeployMate Environment Configuration

# API Configuration
VITE_API_BASE_URL=http://localhost:3001/api
VITE_APP_ENV=development

# GitHub OAuth Configuration
VITE_GITHUB_CLIENT_ID=your_github_client_id
VITE_GITHUB_REDIRECT_URI=http://localhost:5173/auth/github/callback

# Vercel Integration
VITE_VERCEL_CLIENT_ID=your_vercel_client_id
VITE_VERCEL_REDIRECT_URI=http://localhost:5173/auth/vercel/callback

# Stripe Configuration
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key

# Application Configuration
VITE_APP_NAME=DeployMate
VITE_APP_VERSION=1.0.0
VITE_APP_DESCRIPTION=Launch your web app in minutes, not days.

# Feature Flags
VITE_ENABLE_MONITORING=true
VITE_ENABLE_ANALYTICS=true
VITE_ENABLE_NOTIFICATIONS=true

# Monitoring Configuration
VITE_SENTRY_DSN=your_sentry_dsn
VITE_ANALYTICS_ID=your_analytics_id

# WebSocket Configuration (for real-time updates)
VITE_WS_URL=ws://localhost:3001

# CDN Configuration
VITE_CDN_URL=https://cdn.deploymate.dev

# Support Configuration
VITE_SUPPORT_EMAIL=support@deploymate.dev
VITE_DOCS_URL=https://docs.deploymate.dev
